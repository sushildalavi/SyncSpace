# --- Core ---------------------------------------------------------------
DATABASE_URL=postgres://syncspace:syncspace@localhost:5432/syncspace
REDIS_URL=redis://localhost:6379
# 32+ random characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-string-at-least-32-chars
API_BASE_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000
API_PORT=3001
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# --- Email (local dev: Mailpit from docker compose, UI on :8025) ----------
SMTP_URL=smtp://localhost:1025
MAIL_FROM="SyncSpace <no-reply@syncspace.local>"
REQUIRE_EMAIL_VERIFICATION=false

# --- Google sign-in (optional). Leave BOTH empty to hide the Google button.
# See docs/googleSignIn.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- One-off MongoDB -> PostgreSQL migration only -------------------------
LEGACY_MONGO_URL=
