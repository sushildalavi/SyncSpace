{
  "name": "syncspace",
  "description": "Real-time collaborative document editor with offline editing, role-based sharing and two-factor sign-in.",
  "keywords": [
    "collaboration",
    "real-time",
    "collaborative-editing",
    "crdt",
    "yjs",
    "offline-first",
    "nextjs",
    "nestjs",
    "postgresql",
    "redis",
    "websockets",
    "typescript"
  ],
  "homepage": "https://github.com/sushildalavi/SyncSpace#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sushildalavi/SyncSpace.git"
  },
  "author": "Sushil Ravindra Dalavi",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @syncspace/api db:generate",
    "db:migrate": "pnpm --filter @syncspace/api db:migrate"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.34.0",
    "@next/eslint-plugin-next": "15.5.2",
    "@playwright/test": "^1.62.1",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "eslint": "^9.39.5",
    "turbo": "^2.5.6"
  }
}
