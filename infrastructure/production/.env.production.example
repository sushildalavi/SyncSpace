# Copy to .env.production (ignored by git) and fill in. Never commit the filled-in file.

# Two names under ONE domain you control, both pointing at this server.
# Sign-in cookies will not work if they are on different registrable domains.
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com

# openssl rand -base64 32
BETTER_AUTH_SECRET=
# openssl rand -hex 32   (hex, because it is placed inside a connection URL)
POSTGRES_PASSWORD=

# Required: sign-up confirmation, password reset and invitations are sent by email.
# Format: smtp://USER:PASSWORD@HOST:587  (URL-encode special characters)
SMTP_URL=
MAIL_FROM=SyncSpace <no-reply@example.com>

# Optional Google sign-in: set both or neither. See docs/auth/google-setup.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
